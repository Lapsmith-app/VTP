{
  "protocol": {
    "name": "VTP",
    "major": 1,
    "minor": 0,
    "endianness": "little",
    "min_att_mtu": 100
  },
  "profile": {
    "characteristics": [
      {
        "name": "info",
        "capability": null,
        "properties": [
          "read"
        ],
        "cccd": "none",
        "written_by": "device",
        "read_by": "client",
        "inert": "never; Info is always meaningful",
        "record": "info"
      },
      {
        "name": "gps",
        "capability": "gps",
        "properties": [
          "notify"
        ],
        "cccd": "notify",
        "written_by": "device",
        "read_by": "client",
        "inert": "notifications are never sent",
        "record": "gps_fix"
      },
      {
        "name": "can",
        "capability": "can",
        "properties": [
          "notify"
        ],
        "cccd": "notify",
        "written_by": "device",
        "read_by": "client",
        "inert": "notifications are never sent",
        "record": "can_header"
      },
      {
        "name": "imu",
        "capability": "imu",
        "properties": [
          "notify"
        ],
        "cccd": "notify",
        "written_by": "device",
        "read_by": "client",
        "inert": "notifications are never sent",
        "record": "imu_header"
      },
      {
        "name": "control",
        "capability": "control",
        "properties": [
          "write",
          "indicate"
        ],
        "cccd": "indicate",
        "write_type": "with-response",
        "written_by": "client",
        "read_by": "client",
        "inert": "every opcode answers unsupported_opcode",
        "record": "control_response"
      },
      {
        "name": "monitor_values",
        "capability": "monitor",
        "properties": [
          "write"
        ],
        "cccd": "none",
        "write_type": "with-response",
        "written_by": "client",
        "read_by": "device",
        "inert": "every write answers with an ATT error and changes nothing",
        "record": "monitor_header"
      }
    ],
    "capacity": {
      "gps": [
        "gps_rate_hz",
        "gps_max_rate_hz"
      ],
      "can": [
        "can_subscription_slots",
        "can_max_frames_per_s",
        "can_max_payload"
      ],
      "imu": [
        "imu_rate_hz",
        "imu_max_rate_hz"
      ]
    }
  },
  "enums": {
    "fix_type": {
      "width": 1,
      "members": [
        {
          "value": 0,
          "name": "none",
          "desc": "No position solution"
        },
        {
          "value": 1,
          "name": "dead_reckon",
          "desc": "Dead-reckoning solution only"
        },
        {
          "value": 2,
          "name": "fix_2d",
          "desc": "2D position solution"
        },
        {
          "value": 3,
          "name": "fix_3d",
          "desc": "3D position solution"
        },
        {
          "value": 4,
          "name": "gnss_dr",
          "desc": "Combined GNSS and dead-reckoning"
        },
        {
          "value": 5,
          "name": "time_only",
          "desc": "Time solution only, no position"
        }
      ]
    },
    "status": {
      "width": 1,
      "members": [
        {
          "value": 0,
          "name": "ok",
          "desc": "Request accepted"
        },
        {
          "value": 1,
          "name": "unsupported_opcode",
          "desc": "Opcode not implemented"
        },
        {
          "value": 2,
          "name": "bad_params",
          "desc": "Parameters malformed or out of range, or the tag is already outstanding"
        },
        {
          "value": 3,
          "name": "table_full",
          "desc": "No free subscription slot"
        },
        {
          "value": 4,
          "name": "rate_exceeded",
          "desc": "Requested rate is above gps_max_rate_hz or imu_max_rate_hz (SPEC.md 9.8). Never used for CAN"
        },
        {
          "value": 5,
          "name": "busy",
          "desc": "No room for another outstanding request; retry (SPEC.md 9)"
        },
        {
          "value": 6,
          "name": "needs_encryption",
          "desc": "Allocated, never sent: encryption is enforced by GATT permission (SPEC.md 10)"
        },
        {
          "value": 7,
          "name": "unknown_handle",
          "desc": "No subscription with that handle"
        }
      ]
    },
    "sub_mode": {
      "width": 1,
      "members": [
        {
          "value": 0,
          "name": "every_frame",
          "desc": "Forward every frame"
        },
        {
          "value": 1,
          "name": "periodic",
          "desc": "arg = minimum interval, ms"
        },
        {
          "value": 2,
          "name": "on_change",
          "desc": "arg = debounce interval, ms"
        },
        {
          "value": 3,
          "name": "every_nth",
          "desc": "arg = N"
        }
      ]
    },
    "channel": {
      "width": 2,
      "members": [
        {
          "value": 1,
          "name": "lap_time",
          "desc": "Elapsed time in the current lap, ms"
        },
        {
          "value": 2,
          "name": "last_lap_time",
          "desc": "ms"
        },
        {
          "value": 3,
          "name": "best_lap_time",
          "desc": "ms"
        },
        {
          "value": 4,
          "name": "delta_best",
          "desc": "Time ahead of or behind the best lap, ms, signed"
        },
        {
          "value": 5,
          "name": "predicted_lap_time",
          "desc": "ms"
        },
        {
          "value": 6,
          "name": "lap_number",
          "desc": "Laps completed in this session, from 1"
        },
        {
          "value": 7,
          "name": "speed",
          "desc": "mm/s"
        },
        {
          "value": 8,
          "name": "session_distance",
          "desc": "m"
        },
        {
          "value": 9,
          "name": "session_time",
          "desc": "ms"
        }
      ]
    },
    "phy": {
      "width": 1,
      "members": [
        {
          "value": 1,
          "name": "le_1m",
          "desc": "LE 1M"
        },
        {
          "value": 2,
          "name": "le_2m",
          "desc": "LE 2M"
        },
        {
          "value": 3,
          "name": "le_coded",
          "desc": "LE Coded"
        }
      ]
    }
  },
  "bitmasks": {
    "gps_validity": {
      "width": 4,
      "bits": [
        {
          "bit": 0,
          "name": "t_utc",
          "desc": "t_utc carries a GNSS time solution"
        },
        {
          "bit": 1,
          "name": "t_utc_resolved",
          "desc": "Leap seconds fully resolved"
        },
        {
          "bit": 2,
          "name": "position",
          "desc": "lat and lon are valid"
        },
        {
          "bit": 3,
          "name": "alt_msl"
        },
        {
          "bit": 4,
          "name": "alt_ellipsoid"
        },
        {
          "bit": 5,
          "name": "velocity",
          "desc": "vel_n, vel_e and vel_d are all valid"
        },
        {
          "bit": 6,
          "name": "head_mot"
        },
        {
          "bit": 7,
          "name": "h_acc"
        },
        {
          "bit": 8,
          "name": "v_acc"
        },
        {
          "bit": 9,
          "name": "s_acc"
        },
        {
          "bit": 10,
          "name": "p_dop"
        },
        {
          "bit": 11,
          "name": "num_sv"
        }
      ],
      "reserved_from": 12
    },
    "fix_flags": {
      "width": 1,
      "bits": [
        {
          "bit": 0,
          "name": "differential",
          "desc": "Differential corrections applied"
        },
        {
          "bit": 1,
          "name": "rtk_float"
        },
        {
          "bit": 2,
          "name": "rtk_fixed"
        },
        {
          "bit": 3,
          "name": "clock_disciplined",
          "desc": "t_device was GNSS-disciplined at this sample"
        },
        {
          "bit": 4,
          "name": "solution_epoch",
          "desc": "t_device is the epoch of the solution; when clear it is when the fix reached the device (SPEC.md 5.6)"
        }
      ],
      "reserved_from": 5
    },
    "capabilities": {
      "width": 4,
      "bits": [
        {
          "bit": 0,
          "name": "gps"
        },
        {
          "bit": 1,
          "name": "can",
          "implies": [
            "control"
          ]
        },
        {
          "bit": 2,
          "name": "imu"
        },
        {
          "bit": 3,
          "name": "monitor",
          "implies": [
            "control"
          ],
          "desc": "Device asks the client for values to display (\u00a713)"
        },
        {
          "bit": 4,
          "name": "control"
        },
        {
          "bit": 5,
          "name": "can_fd",
          "implies": [
            "can"
          ]
        },
        {
          "bit": 6,
          "name": "masked_subscriptions",
          "implies": [
            "can"
          ]
        },
        {
          "bit": 7,
          "name": "on_change_subscriptions",
          "implies": [
            "can"
          ]
        }
      ],
      "reserved_from": 8
    },
    "monitor_validity": {
      "width": 1,
      "bits": [
        {
          "bit": 0,
          "name": "present",
          "desc": "The client can currently supply this channel"
        }
      ],
      "reserved_from": 1
    },
    "link_validity": {
      "width": 2,
      "bits": [
        {
          "bit": 0,
          "name": "att_mtu",
          "desc": "att_mtu carries the negotiated value"
        },
        {
          "bit": 1,
          "name": "ll_data_length",
          "desc": "ll_max_tx_octets and ll_max_rx_octets are valid"
        },
        {
          "bit": 2,
          "name": "conn_params",
          "desc": "conn_interval, peripheral_latency and supervision_timeout are all valid"
        },
        {
          "bit": 3,
          "name": "phy",
          "desc": "phy_tx and phy_rx are valid"
        }
      ],
      "reserved_from": 4
    }
  },
  "records": {
    "info": {
      "characteristic": "info",
      "size": 24,
      "access": "read",
      "desc": "Device self-description. Read once per connection; never cached across connections.",
      "fields": [
        {
          "name": "protocol_major",
          "offset": 0,
          "size": 1,
          "type": "u8",
          "desc": "MUST equal 1; cross-check against the discovered service UUID"
        },
        {
          "name": "protocol_minor",
          "offset": 1,
          "size": 1,
          "type": "u8"
        },
        {
          "name": "capabilities",
          "offset": 2,
          "size": 4,
          "type": "u32",
          "bitmask": "capabilities"
        },
        {
          "name": "gps_rate_hz",
          "offset": 6,
          "size": 2,
          "type": "u16",
          "units": "Hz",
          "desc": "Current rate; 0 if no GPS"
        },
        {
          "name": "gps_max_rate_hz",
          "offset": 8,
          "size": 2,
          "type": "u16",
          "units": "Hz"
        },
        {
          "name": "can_subscription_slots",
          "offset": 10,
          "size": 2,
          "type": "u16"
        },
        {
          "name": "can_max_frames_per_s",
          "offset": 12,
          "size": 4,
          "type": "u32",
          "units": "frames/s"
        },
        {
          "name": "imu_rate_hz",
          "offset": 16,
          "size": 2,
          "type": "u16",
          "units": "Hz"
        },
        {
          "name": "imu_max_rate_hz",
          "offset": 18,
          "size": 2,
          "type": "u16",
          "units": "Hz"
        },
        {
          "name": "can_max_payload",
          "offset": 20,
          "size": 1,
          "type": "u8",
          "desc": "8 for classic CAN, 64 for CAN FD"
        },
        {
          "name": "clock_flags",
          "offset": 21,
          "size": 1,
          "type": "u8",
          "desc": "bit0 GNSS-disciplined, bit1 clock survives reconnect"
        },
        {
          "name": "max_notify_bytes",
          "offset": 22,
          "size": 2,
          "type": "u16",
          "units": "bytes",
          "desc": "Largest notification this device will ever send; a fixed device ceiling, NOT the negotiated ATT payload (SPEC.md 4.2)"
        }
      ]
    },
    "gps_fix": {
      "characteristic": "gps",
      "size": 74,
      "access": "notify",
      "extensible": true,
      "validity": "gps_validity",
      "desc": "One complete position solution. Never split, never paired, never packed.",
      "fields": [
        {
          "name": "seq",
          "offset": 0,
          "size": 2,
          "type": "u16",
          "desc": "Notifications sent on this characteristic; +1 each, wraps, restarts at 0 per connection"
        },
        {
          "name": "dropped",
          "offset": 2,
          "size": 2,
          "type": "u16",
          "desc": "Fixes accepted then discarded since the previous notification; saturates, never wraps"
        },
        {
          "name": "validity",
          "offset": 4,
          "size": 4,
          "type": "u32",
          "bitmask": "gps_validity"
        },
        {
          "name": "t_device",
          "offset": 8,
          "size": 8,
          "type": "u64",
          "units": "\u00b5s",
          "desc": "Monotonic device clock (\u00a78.1)"
        },
        {
          "name": "t_utc",
          "offset": 16,
          "size": 8,
          "type": "i64",
          "units": "ms",
          "desc": "Unix epoch",
          "valid_bit": "t_utc"
        },
        {
          "name": "lat",
          "offset": 24,
          "size": 4,
          "type": "i32",
          "units": "deg",
          "scale": 1e-07,
          "valid_bit": "position",
          "desc": "Latitude \u2014 positive north, negative south"
        },
        {
          "name": "lon",
          "offset": 28,
          "size": 4,
          "type": "i32",
          "units": "deg",
          "scale": 1e-07,
          "valid_bit": "position",
          "desc": "Longitude \u2014 positive east, negative west"
        },
        {
          "name": "alt_msl",
          "offset": 32,
          "size": 4,
          "type": "i32",
          "units": "mm",
          "valid_bit": "alt_msl",
          "desc": "Altitude above mean sea level"
        },
        {
          "name": "alt_ellipsoid",
          "offset": 36,
          "size": 4,
          "type": "i32",
          "units": "mm",
          "valid_bit": "alt_ellipsoid",
          "desc": "Altitude above the WGS-84 ellipsoid"
        },
        {
          "name": "vel_n",
          "offset": 40,
          "size": 4,
          "type": "i32",
          "units": "mm/s",
          "valid_bit": "velocity",
          "desc": "Velocity, north component"
        },
        {
          "name": "vel_e",
          "offset": 44,
          "size": 4,
          "type": "i32",
          "units": "mm/s",
          "valid_bit": "velocity",
          "desc": "Velocity, east component"
        },
        {
          "name": "vel_d",
          "offset": 48,
          "size": 4,
          "type": "i32",
          "units": "mm/s",
          "valid_bit": "velocity",
          "desc": "Velocity, down component \u2014 positive descending"
        },
        {
          "name": "head_mot",
          "offset": 52,
          "size": 4,
          "type": "i32",
          "units": "deg",
          "scale": 1e-05,
          "valid_bit": "head_mot",
          "desc": "Heading of motion, clockwise from true north"
        },
        {
          "name": "h_acc",
          "offset": 56,
          "size": 4,
          "type": "u32",
          "units": "mm",
          "desc": "Horizontal position accuracy estimate, 1 sigma",
          "valid_bit": "h_acc"
        },
        {
          "name": "v_acc",
          "offset": 60,
          "size": 4,
          "type": "u32",
          "units": "mm",
          "desc": "Vertical position accuracy estimate, 1 sigma",
          "valid_bit": "v_acc"
        },
        {
          "name": "s_acc",
          "offset": 64,
          "size": 4,
          "type": "u32",
          "units": "mm/s",
          "desc": "Speed accuracy estimate, 1 sigma",
          "valid_bit": "s_acc"
        },
        {
          "name": "p_dop",
          "offset": 68,
          "size": 2,
          "type": "u16",
          "scale": 0.01,
          "valid_bit": "p_dop",
          "desc": "Position dilution of precision"
        },
        {
          "name": "fix_type",
          "offset": 70,
          "size": 1,
          "type": "u8",
          "enum": "fix_type"
        },
        {
          "name": "num_sv",
          "offset": 71,
          "size": 1,
          "type": "u8",
          "valid_bit": "num_sv",
          "desc": "Satellites used in the solution"
        },
        {
          "name": "fix_flags",
          "offset": 72,
          "size": 1,
          "type": "u8",
          "bitmask": "fix_flags"
        },
        {
          "name": "ext_count",
          "offset": 73,
          "size": 1,
          "type": "u8",
          "desc": "Extension records following the base record"
        }
      ]
    },
    "can_header": {
      "characteristic": "can",
      "size": 16,
      "access": "notify",
      "desc": "Batch header. Followed by `count` can_record entries.",
      "fields": [
        {
          "name": "seq",
          "offset": 0,
          "size": 2,
          "type": "u16",
          "desc": "Notifications sent on this characteristic; +1 each, wraps, restarts at 0 per connection"
        },
        {
          "name": "dropped",
          "offset": 2,
          "size": 2,
          "type": "u16",
          "desc": "Frames accepted then discarded since the previous notification; excludes frames no subscription matched or a subscription mode did not select; saturates"
        },
        {
          "name": "t_base",
          "offset": 4,
          "size": 8,
          "type": "u64",
          "units": "\u00b5s",
          "desc": "Bus-arrival time of record 0, on the device clock (\u00a78.1)"
        },
        {
          "name": "count",
          "offset": 12,
          "size": 1,
          "type": "u8"
        },
        {
          "name": "flags",
          "offset": 13,
          "size": 1,
          "type": "u8",
          "desc": "bit0 device is shedding load \u2014 discarding accepted frames (\u00a76.3)"
        },
        {
          "name": "reserved",
          "offset": 14,
          "size": 2,
          "type": "u16",
          "reserved": true
        }
      ]
    },
    "can_record": {
      "size": 7,
      "variable": "payload",
      "desc": "One CAN frame with a device-measured bus-arrival time.",
      "fields": [
        {
          "name": "dt",
          "offset": 0,
          "size": 2,
          "type": "u16",
          "units": "10\u00b5s",
          "desc": "Ticks since this batch's own t_base; window is 0..655.35 ms"
        },
        {
          "name": "id",
          "offset": 2,
          "size": 4,
          "type": "u32",
          "desc": "bits 0-28 arbitration id; b29 extended; b30 CAN FD; b31 RTR"
        },
        {
          "name": "len",
          "offset": 6,
          "size": 1,
          "type": "u8",
          "desc": "Payload length; Classic 0..8, CAN FD a DLC rung (SPEC.md 6.10)"
        }
      ]
    },
    "imu_header": {
      "characteristic": "imu",
      "size": 20,
      "access": "notify",
      "desc": "Batch header. Followed by `count` evenly spaced imu_sample entries.",
      "fields": [
        {
          "name": "seq",
          "offset": 0,
          "size": 2,
          "type": "u16",
          "desc": "Notifications sent on this characteristic; +1 each, wraps, restarts at 0 per connection"
        },
        {
          "name": "dropped",
          "offset": 2,
          "size": 2,
          "type": "u16",
          "desc": "Samples accepted then discarded since the previous notification; saturates, never wraps"
        },
        {
          "name": "t_base",
          "offset": 4,
          "size": 8,
          "type": "u64",
          "units": "\u00b5s",
          "desc": "Device-clock timestamp of sample 0 (\u00a78.1)"
        },
        {
          "name": "period",
          "offset": 12,
          "size": 4,
          "type": "u32",
          "units": "\u00b5s",
          "desc": "Interval between consecutive samples"
        },
        {
          "name": "count",
          "offset": 16,
          "size": 1,
          "type": "u8"
        },
        {
          "name": "flags",
          "offset": 17,
          "size": 1,
          "type": "u8",
          "desc": "bit0 accel present, bit1 gyro present, bit2 a sample in this batch saturated (SPEC.md 7.2)"
        },
        {
          "name": "reserved",
          "offset": 18,
          "size": 2,
          "type": "u16",
          "reserved": true
        }
      ]
    },
    "imu_sample": {
      "size": 12,
      "desc": "Sensor-frame acceleration and rotation. Vehicle alignment is the client's job.",
      "presence": {
        "record": "imu_header",
        "field": "flags",
        "bits": {
          "accel": 0,
          "gyro": 1
        }
      },
      "fields": [
        {
          "name": "ax",
          "offset": 0,
          "size": 2,
          "type": "i16",
          "units": "mg",
          "desc": "milli-g",
          "presence_bit": "accel"
        },
        {
          "name": "ay",
          "offset": 2,
          "size": 2,
          "type": "i16",
          "units": "mg",
          "presence_bit": "accel"
        },
        {
          "name": "az",
          "offset": 4,
          "size": 2,
          "type": "i16",
          "units": "mg",
          "presence_bit": "accel"
        },
        {
          "name": "gx",
          "offset": 6,
          "size": 2,
          "type": "i16",
          "units": "deg/s",
          "scale": 0.05,
          "presence_bit": "gyro"
        },
        {
          "name": "gy",
          "offset": 8,
          "size": 2,
          "type": "i16",
          "units": "deg/s",
          "scale": 0.05,
          "presence_bit": "gyro"
        },
        {
          "name": "gz",
          "offset": 10,
          "size": 2,
          "type": "i16",
          "units": "deg/s",
          "scale": 0.05,
          "presence_bit": "gyro"
        }
      ]
    },
    "monitor_page": {
      "access": "control",
      "size": 6,
      "desc": "One page of the channels a device asks for. Followed by `count` monitor_channel entries.",
      "fields": [
        {
          "name": "total",
          "offset": 0,
          "size": 2,
          "type": "u16",
          "desc": "Channels requested, across all pages"
        },
        {
          "name": "index",
          "offset": 2,
          "size": 2,
          "type": "u16",
          "desc": "Table index of the first entry in this page"
        },
        {
          "name": "count",
          "offset": 4,
          "size": 1,
          "type": "u8",
          "desc": "Entries in this page"
        },
        {
          "name": "reserved",
          "offset": 5,
          "size": 1,
          "type": "u8",
          "reserved": true
        }
      ]
    },
    "monitor_channel": {
      "access": "control",
      "size": 4,
      "desc": "One channel a device asks the client to supply.",
      "fields": [
        {
          "name": "slot",
          "offset": 0,
          "size": 1,
          "type": "u8",
          "desc": "The device's own name for this value; used in monitor_value"
        },
        {
          "name": "channel",
          "offset": 1,
          "size": 2,
          "type": "u16",
          "enum": "channel"
        },
        {
          "name": "max_age",
          "offset": 3,
          "size": 1,
          "type": "u8",
          "units": "100ms",
          "desc": "Longest this value may be shown without a refresh; 0 means no deadline of its own, but the device's liveness bound still applies (SPEC.md 13.5)"
        }
      ]
    },
    "monitor_header": {
      "characteristic": "monitor_values",
      "size": 4,
      "access": "write",
      "desc": "Batch header for a client-to-device value update. Followed by `count` monitor_value entries.",
      "fields": [
        {
          "name": "seq",
          "offset": 0,
          "size": 2,
          "type": "u16",
          "desc": "Updates written by the client; +1 each, wraps, restarts at 0 per connection"
        },
        {
          "name": "count",
          "offset": 2,
          "size": 1,
          "type": "u8"
        },
        {
          "name": "reserved",
          "offset": 3,
          "size": 1,
          "type": "u8",
          "reserved": true
        }
      ]
    },
    "monitor_value": {
      "size": 6,
      "validity": "monitor_validity",
      "desc": "One value for a slot the device asked for.",
      "fields": [
        {
          "name": "slot",
          "offset": 0,
          "size": 1,
          "type": "u8"
        },
        {
          "name": "validity",
          "offset": 1,
          "size": 1,
          "type": "u8",
          "bitmask": "monitor_validity"
        },
        {
          "name": "value",
          "offset": 2,
          "size": 4,
          "type": "i32",
          "valid_bit": "present"
        }
      ]
    },
    "can_list_page": {
      "access": "control",
      "size": 6,
      "desc": "One page of the CAN subscription table. Followed by `count` can_subscription entries.",
      "fields": [
        {
          "name": "total",
          "offset": 0,
          "size": 2,
          "type": "u16",
          "desc": "Subscriptions installed, across all pages"
        },
        {
          "name": "index",
          "offset": 2,
          "size": 2,
          "type": "u16",
          "desc": "Table index of the first entry in this page"
        },
        {
          "name": "count",
          "offset": 4,
          "size": 1,
          "type": "u8",
          "desc": "Entries in this page"
        },
        {
          "name": "reserved",
          "offset": 5,
          "size": 1,
          "type": "u8",
          "reserved": true
        }
      ]
    },
    "can_subscription": {
      "access": "control",
      "size": 13,
      "desc": "One installed CAN subscription, as the device holds it.",
      "fields": [
        {
          "name": "handle",
          "offset": 0,
          "size": 2,
          "type": "u16",
          "desc": "Identifies this subscription; assigned by the device"
        },
        {
          "name": "id",
          "offset": 2,
          "size": 4,
          "type": "u32",
          "desc": "bits 0-28 arbitration id; b29 extended; b30/b31 ignored"
        },
        {
          "name": "mask",
          "offset": 6,
          "size": 4,
          "type": "u32",
          "desc": "A set bit is a bit of `id` that must match; bits 0-29 only"
        },
        {
          "name": "mode",
          "offset": 10,
          "size": 1,
          "type": "u8",
          "enum": "sub_mode"
        },
        {
          "name": "arg",
          "offset": 11,
          "size": 2,
          "type": "u16",
          "desc": "Interpretation depends on `mode`"
        }
      ]
    },
    "control_response": {
      "access": "control",
      "size": 3,
      "variable": "detail",
      "desc": "The envelope of every Control response. Detail follows only when status is ok.",
      "fields": [
        {
          "name": "opcode",
          "offset": 0,
          "size": 1,
          "type": "u8",
          "desc": "Echoed from the request"
        },
        {
          "name": "tag",
          "offset": 1,
          "size": 1,
          "type": "u8",
          "desc": "Echoed from the request; opaque to the device"
        },
        {
          "name": "status",
          "offset": 2,
          "size": 1,
          "type": "u8",
          "enum": "status"
        }
      ]
    },
    "time_sync": {
      "access": "control",
      "size": 16,
      "desc": "The detail of a TIME_SYNC response. Two readings of one clock, so a client can bound its own error.",
      "fields": [
        {
          "name": "t_device_rx",
          "offset": 0,
          "size": 8,
          "type": "u64",
          "units": "\u00b5s",
          "desc": "Device clock when the request arrived"
        },
        {
          "name": "t_device_tx",
          "offset": 8,
          "size": 8,
          "type": "u64",
          "units": "\u00b5s",
          "desc": "Device clock when this answer was prepared; MUST NOT be earlier than t_device_rx"
        }
      ]
    },
    "link_params": {
      "access": "control",
      "size": 16,
      "validity": "link_validity",
      "desc": "The device's view of the negotiated link. Reported, never negotiated here.",
      "fields": [
        {
          "name": "validity",
          "offset": 0,
          "size": 2,
          "type": "u16",
          "bitmask": "link_validity"
        },
        {
          "name": "att_mtu",
          "offset": 2,
          "size": 2,
          "type": "u16",
          "units": "bytes",
          "valid_bit": "att_mtu"
        },
        {
          "name": "ll_max_tx_octets",
          "offset": 4,
          "size": 2,
          "type": "u16",
          "units": "octets",
          "valid_bit": "ll_data_length"
        },
        {
          "name": "ll_max_rx_octets",
          "offset": 6,
          "size": 2,
          "type": "u16",
          "units": "octets",
          "valid_bit": "ll_data_length"
        },
        {
          "name": "conn_interval",
          "offset": 8,
          "size": 2,
          "type": "u16",
          "units": "1.25ms",
          "valid_bit": "conn_params"
        },
        {
          "name": "peripheral_latency",
          "offset": 10,
          "size": 2,
          "type": "u16",
          "desc": "Connection events the device may skip",
          "valid_bit": "conn_params"
        },
        {
          "name": "supervision_timeout",
          "offset": 12,
          "size": 2,
          "type": "u16",
          "units": "10ms",
          "valid_bit": "conn_params"
        },
        {
          "name": "phy_tx",
          "offset": 14,
          "size": 1,
          "type": "u8",
          "enum": "phy",
          "valid_bit": "phy"
        },
        {
          "name": "phy_rx",
          "offset": 15,
          "size": 1,
          "type": "u8",
          "enum": "phy",
          "valid_bit": "phy"
        }
      ]
    }
  },
  "control": {
    "request": "[opcode:u8][tag:u8][params...]",
    "response": "[opcode:u8][tag:u8][status:u8][detail...]",
    "opcodes": [
      {
        "value": 1,
